{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Markitty desktop permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/**/*.md" },
        { "path": "$HOME/**/*.markdown" },
        { "path": "$DOCUMENT/**/*.md" },
        { "path": "$DOCUMENT/**/*.markdown" },
        { "path": "$DESKTOP/**/*.md" },
        { "path": "$DESKTOP/**/*.markdown" },
        { "path": "$DOWNLOAD/**/*.md" },
        { "path": "$DOWNLOAD/**/*.markdown" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME/**/*.md" },
        { "path": "$HOME/**/*.markdown" },
        { "path": "$DOCUMENT/**/*.md" },
        { "path": "$DOCUMENT/**/*.markdown" },
        { "path": "$DESKTOP/**/*.md" },
        { "path": "$DESKTOP/**/*.markdown" },
        { "path": "$DOWNLOAD/**/*.md" },
        { "path": "$DOWNLOAD/**/*.markdown" }
      ]
    }
  ]
}
